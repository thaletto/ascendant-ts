{
  "name": "astro-ascendant",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./chart/divisional-mapping": {
      "types": "./dist/chart/divisional-mapping.d.ts",
      "import": "./dist/chart/divisional-mapping.js"
    },
    "./dasha": {
      "types": "./dist/dasha/index.d.ts",
      "import": "./dist/dasha/index.js"
    },
    "./ephemeris": {
      "types": "./dist/ephemeris/index.d.ts",
      "import": "./dist/ephemeris/index.js"
    },
    "./sav": {
      "types": "./dist/sav/index.d.ts",
      "import": "./dist/sav/index.js"
    },
    "./astro-params": {
      "types": "./dist/astro-params/index.d.ts",
      "import": "./dist/astro-params/index.js"
    },
    "./argala": {
      "types": "./dist/argala.d.ts",
      "import": "./dist/argala.js"
    },
    "./arudha-pada": {
      "types": "./dist/arudha-pada.d.ts",
      "import": "./dist/arudha-pada.js"
    },
    "./chara-karakas": {
      "types": "./dist/chara-karakas.d.ts",
      "import": "./dist/chara-karakas.js"
    },
    "./karakamsha": {
      "types": "./dist/karakamsha.d.ts",
      "import": "./dist/karakamsha.js"
    },
    "./rashi-drishti": {
      "types": "./dist/rashi-drishti.d.ts",
      "import": "./dist/rashi-drishti.js"
    },
    "./upapada": {
      "types": "./dist/upapada.d.ts",
      "import": "./dist/upapada.js"
    },
    "./swisseph": {
      "types": "./dist/swisseph/index.d.ts",
      "import": "./dist/swisseph/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --ignore-pattern='repos/**' --ignore-pattern='dist/**'",
    "lint:fix": "oxlint --fix --type-aware --ignore-pattern='repos/**' --ignore-pattern='dist/**'",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "package:check": "bun run build && tsc -p tsconfig.package.json && bun tests/package/runtime.mjs && bun pm pack --dry-run",
    "check": "bun run typecheck && bun run test && bun run lint && bun run fmt:check && bun run build"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "^4.0.0-rc.111",
    "@swisseph/node": "^1.3.1",
    "effect": "^4.0.0-rc.111",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "7",
    "typescript": "7.0.2",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@swisseph/node": "^1.3.1",
    "effect": "^4.0.0-rc.111"
  },
  "peerDependenciesMeta": {
    "@swisseph/node": {
      "optional": true
    }
  },
  "trustedDependencies": [
    "@swisseph/node",
    "msgpackr-extract"
  ]
}
