{
  "name": "astro-ascendant",
  "version": "0.1.1",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://ascendant-docs.vercel.app",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./chart/divisional-mapping": {
      "types": "./dist/chart/divisional-mapping/index.d.ts",
      "import": "./dist/chart/divisional-mapping/index.js"
    },
    "./dasha": {
      "types": "./dist/dasha/index.d.ts",
      "import": "./dist/dasha/index.js"
    },
    "./ephemeris": {
      "types": "./dist/ephemeris/index.d.ts",
      "import": "./dist/ephemeris/index.js"
    },
    "./sav": {
      "types": "./dist/sav/index.d.ts",
      "import": "./dist/sav/index.js"
    },
    "./yoga": {
      "types": "./dist/yoga/index.d.ts",
      "import": "./dist/yoga/index.js"
    },
    "./astro-params": {
      "types": "./dist/astro-params/index.d.ts",
      "import": "./dist/astro-params/index.js"
    },
    "./argala": {
      "types": "./dist/jaimini/argala/index.d.ts",
      "import": "./dist/jaimini/argala/index.js"
    },
    "./arudha-pada": {
      "types": "./dist/jaimini/arudha-pada/index.d.ts",
      "import": "./dist/jaimini/arudha-pada/index.js"
    },
    "./chara-karakas": {
      "types": "./dist/jaimini/chara-karakas/index.d.ts",
      "import": "./dist/jaimini/chara-karakas/index.js"
    },
    "./karakamsha": {
      "types": "./dist/jaimini/karakamsha/index.d.ts",
      "import": "./dist/jaimini/karakamsha/index.js"
    },
    "./rashi-drishti": {
      "types": "./dist/jaimini/rashi-drishti/index.d.ts",
      "import": "./dist/jaimini/rashi-drishti/index.js"
    },
    "./upapada": {
      "types": "./dist/jaimini/upapada/index.d.ts",
      "import": "./dist/jaimini/upapada/index.js"
    },
    "./swisseph": {
      "types": "./dist/swisseph/index.d.ts",
      "import": "./dist/swisseph/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --ignore-pattern='repos/**' --ignore-pattern='dist/**'",
    "lint:fix": "oxlint --fix --type-aware --ignore-pattern='repos/**' --ignore-pattern='dist/**'",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "package:check": "bun run build && tsc -p tsconfig.package.json && bun tests/package/runtime.mjs && bun pm pack --dry-run",
    "check": "bun run typecheck && bun run test && bun run lint && bun run fmt:check && bun run build"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.0.0-rc.112",
    "@effect/tsgo": "0.37.0",
    "@effect/vitest": "^4.0.0-rc.112",
    "@swisseph/node": "^1.3.1",
    "effect": "^4.0.0-rc.112",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@swisseph/node": "^1.3.1",
    "effect": "^4.0.0-rc.112"
  },
  "trustedDependencies": [
    "@swisseph/node",
    "msgpackr-extract"
  ]
}
